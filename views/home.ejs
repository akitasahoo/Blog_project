<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Blog</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- NAVBAR -->

    <nav>

        <h2>My Blog</h2>

        <div>

            <a href="/">Home</a>

            <% if (user) { %>

                <span>
                    Welcome, <%= user.name %>
                </span>

                <a href="/logout">
                    Logout
                </a>

                <% if (user.role === "admin") { %>

                    <a href="/admin/dashboard">
                        Admin Dashboard
                    </a>

                <% } %>

            <% } else { %>

                <a href="/login">
                    Login
                </a>

                <a href="/signup">
                    Signup
                </a>

            <% } %>

        </div>

    </nav>


    <!-- HERO SECTION -->

    <main>

        <h1>
            Welcome to My Blog
        </h1>

        <p>
            Read interesting blogs and share your thoughts.
        </p>


        <!-- BLOGS -->

        <section>

            <h2>
                Latest Blogs
            </h2>


            <% if (blogs.length === 0) { %>

                <p>
                    No blogs available yet.
                </p>

            <% } else { %>


                <% blogs.forEach(blog => { %>

                    <div class="blog-card">

                        <h2>
                            <%= blog.title %>
                        </h2>

                        <p>
                            <strong>Category:</strong>
                            <%= blog.category %>
                        </p>

                        <p>
                            <strong>Author:</strong>
                            <%= blog.author.name %>
                        </p>

                        <% if (blog.image) { %>

                            <img
                                src="<%= blog.image %>"
                                alt="<%= blog.title %>"
                                style="max-width: 100%; height: 200px; object-fit: cover;"
                            >

                        <% } %>


                        <p>
                            <%= blog.content.substring(0, 150) %>...
                        </p>


                        <a href="/blog/<%= blog._id %>">

                            <button>
                                Read More
                            </button>

                        </a>

                    </div>

                <% }) %>


            <% } %>

        </section>

    </main>

</body>

</html>