<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Blog</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<nav>

    <h2>My Blog</h2>

    <div>

        <a href="/">Home</a>

        <a href="/admin/dashboard">
            Admin Dashboard
        </a>

        <a href="/logout">
            Logout
        </a>

    </div>

</nav>


<div class="auth-container">

    <h1>Edit Blog</h1>


    <form
        action="/blog/edit/<%= blog._id %>"
        method="POST"
        enctype="multipart/form-data"
    >

        <input
            type="text"
            name="title"
            value="<%= blog.title %>"
            required
        >


        <input
            type="text"
            name="category"
            value="<%= blog.category %>"
            required
        >


        <% if (blog.image) { %>

            <p>Current Image:</p>

            <img
                src="<%= blog.image %>"
                alt="Blog Image"
                style="
                    width: 200px;
                    border-radius: 8px;
                    margin-bottom: 15px;
                "
            >

        <% } %>


        <label>
            Choose New Image
        </label>

        <input
            type="file"
            name="image"
            accept="image/*"
        >


        <textarea
            name="content"
            rows="10"
            required
        ><%= blog.content %></textarea>


        <button type="submit">
            Update Blog
        </button>

    </form>

</div>

</body>

</html>