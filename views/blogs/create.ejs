<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Blog</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<nav>

    <h2>My Blog</h2>

    <div>

        <a href="/">Home</a>

        <a href="/admin/dashboard">
            Admin Dashboard
        </a>

        <a href="/logout">
            Logout
        </a>

    </div>

</nav>


<div class="auth-container">

    <h1>Create New Blog</h1>


    <form
        action="/blog/create"
        method="POST"
        enctype="multipart/form-data"
    >

        <input
            type="text"
            name="title"
            placeholder="Blog Title"
            required
        >


        <input
            type="text"
            name="category"
            placeholder="Category"
            required
        >

<label>Select Blog Image</label>

<input
    type="file"
    name="image"
    id="imageInput"
    accept="image/*"
>

<br><br>

<img
    id="imagePreview"
    src=""
    alt="Image Preview"
    style="
        display: none;
        width: 250px;
        max-height: 200px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 15px;
    "
>


        <textarea
            name="content"
            placeholder="Write your blog content..."
            rows="10"
            required
        ></textarea>


        <button type="submit">
            Publish Blog
        </button>

    </form>

</div>
<script>
    const imageInput = document.getElementById("imageInput");
    const imagePreview = document.getElementById("imagePreview");

    imageInput.addEventListener("change", function () {
        const file = this.files[0];

        if (file) {
            imagePreview.src = URL.createObjectURL(file);
            imagePreview.style.display = "block";
        } else {
            imagePreview.src = "";
            imagePreview.style.display = "none";
        }
    });
</script>
</body>

</html>